{{>header}}

<h2>All Users</h2>
{{#if message}}
    <p class="message" style="color: green;">{{message}}</p>
    {{/if}}
{{#if users.length}}
<table cellpadding="10" class="table">
    <thead>
        <tr>
            <th>ID</th>
            <th>Name</th>
            <th>Email</th>
            <th>Actions</th>
        </tr>
    </thead>
    {{#each users}}
    <tr>
        <td>{{this.id}}</td>
        <td>{{this.name}}</td>
        <td>{{this.email}}</td>
        <td>
            <a class="c-btn" href="/users/{{this.id}}">View</a>
            <a class="c-btn" href="/users/update/{{this.id}}">Edit</a>
            <form action="/users/delete/{{this.id}}" method="" style="display:inline;">
                <button type="submit" onclick="return confirm('Are you sure?')">Delete</button>
            </form>
        </td>
    </tr>
    {{/each}}
</table>
{{else}}
<p class="p4">No users found.</p>
{{/if}}
{{!-- <p class="create"><a class="c-btn" href="/users/create">Create New User</a></p> --}}
<p class="logout"><a class="c-btn" href="/login">Logout</a></p>

{{>footer}}