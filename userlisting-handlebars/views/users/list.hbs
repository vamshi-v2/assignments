{{>header}}

<h2>All Users</h2>
{{#if users.length}}
<table cellpadding="10">
    <thead>
        <tr>
            <th>ID</th>
            <th>Name</th>
            <th>Email</th>
            <th>Actions</th>
        </tr>
    </thead>
    {{#each users}}
    <tr>
        <td>{{this.id}}</td>
        <td>{{this.name}}</td>
        <td>{{this.email}}</td>
        <td>
            <button><a href="/users/{{this.id}}">View</a></button>
            <button><a href="/users/update/{{this.id}}">Edit</a> </button>
            <form action="/users/delete/{{this.id}}" method="" style="display:inline;">
                <button type="submit" onclick="return confirm('Are you sure?')">Delete</button>
            </form>
        </td>
    </tr>
    {{/each}}
</table>
{{else}}
<p>No users found.</p>
{{/if}}
<p><a href="/users/create">Create New User</a></p>

{{>footer}}